# Normalise line endings in the repo; pin LF for anything that runs inside a
# Linux container or on a Linux server. A CRLF shell script copied into an
# image fails with the confusing "bash\r: No such file or directory".
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
Caddyfile text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.dockerignore text eol=lf
