# Development environment. SAFE TO COMMIT: every secret here is a public,
# obviously-fake placeholder. The backend allows them only when
# ENVIRONMENT=development (docker-compose.dev.yml sets that) and refuses to
# start with them in production.
#
# Used by `make dev`:
#   docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up --build

POSTGRES_USER=cloud
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=personal_cloud
JWT_SECRET=dev-only-insecure-jwt-secret-do-not-deploy

# The proxy listens here instead of 80/443 so it does not clash with anything
# already running on a developer machine.
HTTP_PORT=8080
HTTPS_PORT=8443
