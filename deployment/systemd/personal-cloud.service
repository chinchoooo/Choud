# Runs the Docker Compose stack on boot. Installed (with the right path filled
# in) by deployment/scripts/install-systemd.sh - see docs/deployment.md.
#
# The containers also have `restart: unless-stopped`, so a crashed container is
# restarted by Docker itself; this unit is what brings the stack up after a
# reboot and gives you `systemctl status personal-cloud`.

[Unit]
Description=Personal Cloud (Docker Compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@INSTALL_DIR@
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
