# Reverse proxy: the only service published to the network. See
# docs/deployment.md.
#
# Plain HTTP on :80 is right for LAN / Tailscale access (Tailscale already
# encrypts the traffic between devices). For a public domain with automatic
# HTTPS, replace ":80" with your hostname (e.g. "cloud.example.com") and Caddy
# will provision a certificate automatically.

# Optional global settings: trust the address the tunnel/funnel tells us about, so per-visitor rate
# limits work for people arriving on the public port below.
{
    servers :8081 {
        trusted_proxies static private_ranges
        # Read X-Forwarded-For from the right (what OUR tunnel appended), not the left (what the visitor typed).
        trusted_proxies_strict
    }
}

# The PUBLIC door (docker-compose publishes it on 127.0.0.1 only; you point Tailscale Funnel, a
# Cloudflare Tunnel or a port forward at it). It serves share pages and nothing else: no app, no API,
# no login. Everything else answers 404, so exposing this port never exposes your drive.
:8081 {
    header {
        ?X-Content-Type-Options "nosniff"
        ?Referrer-Policy "no-referrer"
        ?X-Frame-Options "DENY"
        -Server
    }

    handle /s/* {
        request_body {
            max_size 160MB
        }
        # Hand the backend ONE address: the last one that is not our own tunnel (what the tunnel saw),
        # never a leading value a visitor typed into X-Forwarded-For to dodge the per-visitor limits.
        reverse_proxy backend:8000 {
            header_up X-Forwarded-For {client_ip}
        }
    }

    handle {
        respond "Not found" 404
    }
}

:80 {
    # Compress what compresses (API JSON, text). Photos, video and anything already compressed pass
    # through untouched; the web image compresses its own files.
    encode zstd gzip {
        minimum_length 512
        match {
            header Content-Type application/json*
            header Content-Type text/*
            header Content-Type application/javascript*
            header Content-Type image/svg+xml*
        }
    }

    # Baseline security headers on everything the backend answers. The "?" prefix means "only if the
    # response does not already set it", so the stricter policies the backend (previews, public share
    # pages) and the web image (the app's CSP) send are never overridden.
    header {
        ?X-Content-Type-Options "nosniff"
        ?Referrer-Policy "no-referrer"
        ?X-Frame-Options "DENY"
        ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
    }

    # Only uploads carry big bodies, and the clients keep each request small on purpose:
    # a single-request upload is at most 20 MiB and a chunk 5 MiB. The server refuses more than
    # 128 MiB per request, and this stops an oversized body before it reaches the backend.
    @uploads path /api/files/upload /api/uploads/*
    handle @uploads {
        request_body {
            max_size 160MB
        }
        reverse_proxy backend:8000
    }

    # Everything else is small JSON.
    handle /api/* {
        request_body {
            max_size 10MB
        }
        reverse_proxy backend:8000
    }

    handle /s/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
