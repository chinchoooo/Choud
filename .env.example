# Do not edit this file for a real deployment. Run `scripts/setup.sh`: it copies
# this file to .env and fills in strong random JWT_SECRET / POSTGRES_PASSWORD.
# Never commit the resulting .env file.

# --- PostgreSQL ---
POSTGRES_USER=cloud
POSTGRES_PASSWORD=
POSTGRES_DB=personal_cloud
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage ---
# Root directory (inside the backend/engine containers) where objects,
# chunks and uploads are persisted. Must be a mounted volume, not the
# ephemeral container filesystem.
STORAGE_ROOT=/data/cloud
# Default per-user quota (logical bytes) assigned at registration.
DEFAULT_STORAGE_QUOTA_BYTES=10737418240

# --- C++ Engine ---
ENGINE_HOST=engine
ENGINE_PORT=9000

# --- Reverse proxy (the only published port) ---
# Change these only if 80/443 are already used on this machine.
HTTP_PORT=80
HTTPS_PORT=443

# --- Frontend ---
# Leave empty: the browser calls the same origin and the proxy routes /api/*.
# Only set this for development against a separately-hosted API.
VITE_API_BASE_URL=
