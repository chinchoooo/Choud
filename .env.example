# Do not edit this file for a real deployment. Run `scripts/setup.sh`: it copies
# this file to .env and fills in strong random JWT_SECRET / POSTGRES_PASSWORD.
# Never commit the resulting .env file.

# --- PostgreSQL ---
POSTGRES_USER=cloud
POSTGRES_PASSWORD=
POSTGRES_DB=personal_cloud
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage ---
# Root directory (inside the backend/engine containers) where objects,
# chunks and uploads are persisted. Must be a mounted volume, not the
# ephemeral container filesystem.
STORAGE_ROOT=/data/cloud
# Default per-user quota (logical bytes) assigned at registration.
DEFAULT_STORAGE_QUOTA_BYTES=429496729600

# Who may create accounts: invite (default: the first account is free, then the administrator
# hands out one-time codes in the web app under Invites), open (anyone who can reach the server),
# or closed (nobody new).
REGISTRATION_MODE=invite

# --- Tuning (the defaults are fine for most setups) ---
# Seconds a whole-file engine call (hash/store/reassemble) may take. Raise for
# very large files on slow disks.
ENGINE_DATA_TIMEOUT_SECONDS=1800
# Seconds between housekeeping runs (cleans up abandoned uploads); 0 disables.
MAINTENANCE_INTERVAL_SECONDS=3600
# Rate limit login/register/refresh per client IP.
RATE_LIMIT_ENABLED=true

# --- Backups (used by scripts/backup.sh) ---
# Keep this many backups; older ones are deleted.
# File holding a passphrase that encrypts backups (they contain your secrets). Create it with
#   umask 077; openssl rand -base64 48 > ~/.choud-backup-passphrase
# and keep a copy somewhere other than this machine, or the backups cannot be restored.
BACKUP_PASSPHRASE_FILE=
BACKUP_KEEP=14
# ALSO copy each backup here (an external drive or network share). Strongly
# recommended: a backup on the same disk as the data is not a backup.
# BACKUP_COPY_TO=/media/usb-drive/personal-cloud-backups

# --- C++ Engine ---
ENGINE_HOST=engine
ENGINE_PORT=9000

# --- Reverse proxy (the only published port) ---
# Change these only if 80/443 are already used on this machine.
HTTP_PORT=80
HTTPS_PORT=443

# --- Frontend ---
# Leave empty: the browser calls the same origin and the proxy routes /api/*.
# Only set this for development against a separately-hosted API.
VITE_API_BASE_URL=

# --- Alerts (optional) ---------------------------------------------------------
# Where to send a message when the health check or a backup fails (and when it recovers).
# ntfy (https://ntfy.sh/<your-secret-topic>), a Discord webhook or a Slack webhook all work.
# Leave empty for no alerts. Repeats are limited to one per ALERT_REMINDER_HOURS while failing.
ALERT_WEBHOOK_URL=
ALERT_REMINDER_HOURS=24

# --- Garbage collection (optional) ---------------------------------------------
# The backend reports once a day which stored objects nothing references. It only deletes them if
# you set GC_DELETE_ENABLED=true (or run scripts/gc.sh --delete by hand). Anything newer than the
# grace period is never touched.
GC_DELETE_ENABLED=false
GC_GRACE_HOURS=72
